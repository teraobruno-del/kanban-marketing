# Variáveis do projeto. Na Vercel, cadastre em: Project → Settings → Environment Variables.
# Para rodar no seu computador, copie este arquivo para ".env". NUNCA coloque o .env no Git.

# Banco (Supabase → botão "Connect" no topo do projeto)
# "Transaction pooler" (porta 6543) — usada pelo site
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# "Session pooler" (porta 5432) — usada para criar/atualizar as tabelas
DIRECT_URL="postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
# Opcional: certificado do Supabase (Database → Settings → SSL → Download certificate),
# para conexão criptografada e verificada. Cole o conteúdo inteiro do arquivo.
DATABASE_CA_CERT=""

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # chave pública
SUPABASE_SECRET_KEY="sb_secret_..."                          # chave secreta (só no servidor)

# Primeiro Administrador (P10): vale só enquanto não existir nenhum usuário
INITIAL_ADMIN_EMAIL="voce@empresa.com"
INITIAL_ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Login com Google (deixe "false" até configurar o Google)
NEXT_PUBLIC_GOOGLE_LOGIN="false"
