# Copie este arquivo para ".env" e preencha na fase F1 (conexão com o Supabase).
# NUNCA coloque o arquivo .env no Git.

# Conexão via pooler (usada pelo app em produção / Vercel)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
# Conexão direta (usada pelo Prisma para migrações)
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Supabase (painel do projeto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon"
