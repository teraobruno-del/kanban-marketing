// Schema do banco de dados — Kanban de Gestão de Marketing
// Fonte oficial das regras: docs/SPEC.md (+ decisões em docs/DECISOES.md).
//
// Convenções:
// - Modelos e campos em inglês (camelCase no código).
// - Tabelas e colunas no banco em snake_case (@@map / @map), para facilitar as
//   políticas de RLS escritas em SQL no Supabase.
// - Datas/horas de eventos em timestamptz. O prazo (dueDate) é DATE puro (sem hora).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

/// Papel global do usuário (SPEC §7). O acesso aos quadros é dado quadro a quadro.
enum Role {
  ADMIN
  MEMBER
  OBSERVER
}

/// Etapa gravada no card (SPEC §4). A coluna de prazo de cards ACTIVE
/// (OVERDUE/TODAY/THIS_WEEK/UPCOMING) é CALCULADA, nunca gravada.
enum CardStage {
  NEW
  ACTIVE
  APPROVAL
  CHANGES
  DONE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// Tipos de evento do histórico do card (SPEC §5 e §8). Uma única tabela
/// alimenta o histórico de atividades e as métricas do dashboard.
enum CardEventType {
  CREATED
  STAGE_CHANGED // usa fromStage/toStage
  COMPLETED // card foi para DONE (também registra fromStage/toStage)
  REOPENED // card saiu de DONE
  DUE_DATE_CHANGED
  UPDATED // título, descrição, área
  ASSIGNEES_CHANGED
  LABELS_CHANGED
  CHECKLIST_CHANGED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  COVER_CHANGED
  COMMENTED
  RECURRENCE_SPAWNED // gerou o próximo card da série
  DELETED // exclusão lógica (lixeira)
  RESTORED
}

// ──────────────────────────── Usuários ────────────────────────────

/// Ficha do usuário. O `id` é o mesmo id da conta no Supabase Auth (auth.users).
/// Não há exclusão física: "excluir" = desativar (isActive = false).
model User {
  id            String    @id @db.Uuid
  email         String    @unique
  name          String
  avatarUrl     String?   @map("avatar_url")
  role          Role      @default(MEMBER)
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  boardsCreated      Board[]          @relation("BoardCreatedBy")
  boardMemberships   BoardMember[]
  cardsCreated       Card[]           @relation("CardCreatedBy")
  cardsDeleted       Card[]           @relation("CardDeletedBy")
  assignments        CardAssignee[]
  checklistItemsDone ChecklistItem[]
  attachments        Attachment[]
  comments           Comment[]
  mentions           CommentMention[]
  events             CardEvent[]

  @@index([role, isActive])
  @@map("users")
}

// ──────────────────────────── Quadros ────────────────────────────

/// Quadro (SPEC §3). As 8 colunas são fixas e não ficam no banco.
model Board {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User            @relation("BoardCreatedBy", fields: [createdById], references: [id])
  members   BoardMember[]
  areas     RequesterArea[]
  labels    Label[]
  cards     Card[]
  events    CardEvent[]

  @@index([archivedAt])
  @@map("boards")
}

/// Quem tem acesso a cada quadro (decisão 1A: o que a pessoa pode fazer
/// vem do papel global; aqui só se define QUEM vê o quadro).
/// Administradores veem todos os quadros mesmo sem estar nesta lista.
model BoardMember {
  boardId String   @map("board_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@id([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

/// Área solicitante — pertence a um quadro (SPEC §3 e §5).
/// Decisão 6A: em uso → só pode ser desativada (isActive = false).
model RequesterArea {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  color     String // hex, ex.: "#E11D48"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([boardId, name])
  @@map("requester_areas")
}

/// Etiqueta (tipo de entrega) — pertence a um quadro. Mesma regra de desativação.
model Label {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  color     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards CardLabel[]

  @@unique([boardId, name])
  @@map("labels")
}

// ───────────────────────────── Cards ─────────────────────────────

model Card {
  id          String    @id @default(uuid()) @db.Uuid
  boardId     String    @map("board_id") @db.Uuid
  title       String
  description String    @default("") // Markdown
  stage       CardStage @default(NEW)
  /// Prazo: só a data, sem hora (SPEC §4.1).
  dueDate     DateTime? @map("due_date") @db.Date

  requesterAreaId String @map("requester_area_id") @db.Uuid
  createdById     String @map("created_by_id") @db.Uuid

  /// Conclusão (SPEC §6.B). Limpos ao reabrir (premissa P4).
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  /// null quando o card não tem prazo (premissa P2).
  completedOnTime Boolean?  @map("completed_on_time")

  coverAttachmentId String? @unique @map("cover_attachment_id") @db.Uuid

  // Recorrência (SPEC §6.C)
  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  /// Data final opcional (inclusiva).
  recurrenceEndDate   DateTime?            @map("recurrence_end_date") @db.Date
  /// Dia do mês original da série (1–31), usado na recorrência mensal (decisão 3A).
  recurrenceAnchorDay Int?                 @map("recurrence_anchor_day") @db.SmallInt
  /// Card anterior da série. É ÚNICO: cada card gera no máximo um sucessor,
  /// o que garante no banco a regra de idempotência.
  recurrenceParentId  String?              @unique @map("recurrence_parent_id") @db.Uuid

  // Exclusão lógica (decisão 5A)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  board            Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  requesterArea    RequesterArea  @relation(fields: [requesterAreaId], references: [id], onDelete: NoAction)
  createdBy        User           @relation("CardCreatedBy", fields: [createdById], references: [id])
  deletedBy        User?          @relation("CardDeletedBy", fields: [deletedById], references: [id])
  coverAttachment  Attachment?    @relation("CardCover", fields: [coverAttachmentId], references: [id], onDelete: SetNull)
  recurrenceParent Card?          @relation("RecurrenceSeries", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChild  Card?          @relation("RecurrenceSeries")
  assignees        CardAssignee[]
  labels           CardLabel[]
  checklists       Checklist[]
  attachments      Attachment[]   @relation("CardAttachments")
  comments         Comment[]
  events           CardEvent[]

  /// Montagem do quadro: cards de um quadro por etapa, ordenados por prazo.
  @@index([boardId, deletedAt, stage, dueDate, createdAt])
  @@index([requesterAreaId])
  @@index([createdById])
  @@index([completedAt])
  @@map("cards")
}

model CardAssignee {
  cardId     String   @map("card_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([cardId, userId])
  @@index([userId])
  @@map("card_assignees")
}

model CardLabel {
  cardId  String @map("card_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: NoAction)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

// ─────────────────────────── Checklists ───────────────────────────

model Checklist {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  card  Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([cardId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  checklistId String    @map("checklist_id") @db.Uuid
  text        String
  isDone      Boolean   @default(false) @map("is_done")
  doneAt      DateTime? @map("done_at") @db.Timestamptz(3)
  doneById    String?   @map("done_by_id") @db.Uuid
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?     @relation(fields: [doneById], references: [id])

  @@index([checklistId, position])
  @@map("checklist_items")
}

// ──────────────────────────── Anexos ────────────────────────────

/// Arquivo guardado no Supabase Storage. Limite de 10 MB por arquivo
/// (validado no navegador e no servidor — ver src/lib/constants.ts).
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  cardId       String   @map("card_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name")
  storagePath  String   @unique @map("storage_path")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  isImage      Boolean  @default(false) @map("is_image")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  card       Card  @relation("CardAttachments", fields: [cardId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedById], references: [id])
  coverOf    Card? @relation("CardCover")

  @@index([cardId])
  @@map("attachments")
}

// ────────────────────────── Comentários ──────────────────────────

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String // Markdown, com @menções
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  card     Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id])
  mentions CommentMention[]

  @@index([cardId, createdAt])
  @@map("comments")
}

model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

// ─────────────────────── Eventos / Histórico ───────────────────────

/// Linha do tempo de cada card (premissa P6). Toda mudança de etapa gera um
/// evento com fromStage/toStage, data/hora e autor — base das métricas de
/// lead time, gargalo de aprovação e retrabalho (SPEC §8).
model CardEvent {
  id        String        @id @default(uuid()) @db.Uuid
  cardId    String        @map("card_id") @db.Uuid
  /// Copiado do card para filtrar o dashboard por quadro sem junções.
  boardId   String        @map("board_id") @db.Uuid
  actorId   String        @map("actor_id") @db.Uuid
  type      CardEventType
  fromStage CardStage?    @map("from_stage")
  toStage   CardStage?    @map("to_stage")
  /// Detalhes extras (ex.: prazo antigo/novo, campos alterados).
  data      Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([cardId, createdAt])
  @@index([boardId, type, createdAt])
  @@index([actorId])
  @@map("card_events")
}
